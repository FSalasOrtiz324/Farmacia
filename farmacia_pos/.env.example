# Copiar a .env para desarrollo local. Valores ficticios; nunca poner secretos reales aquí.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-me-for-local-development-only
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL de compose.yaml (puerto 5433 para no chocar con un PostgreSQL del sistema)
DATABASE_URL=postgresql://farmacia_app:local-only-password@localhost:5433/farmacia_dev
TIME_ZONE=America/Santiago
CURRENCY_CODE=CLP
# mock solo en desarrollo/pruebas; production.py los rechaza.
PAYMENT_MODE=mock
TAX_DOCUMENT_MODE=mock
PRESCRIPTION_INTEGRATION_MODE=manual_or_mock
